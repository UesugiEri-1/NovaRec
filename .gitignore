# 依赖
node_modules/

# 构建与运行产物
artifacts/
out/
dist/
*.zip

# 开发态数据目录（userData / 录制文件 / 日志）
.data/
.data-*/
.data-shot/
dev.log

# 构建产物（由 scripts/build-launcher.mjs 生成）
assets/NovaRecLauncher.exe

# 调试残留（.tmp-* 用户数据目录 / 临时主进程脚本）
.tmp-*/
.tmp-*.js
.local/

# Electron / 工具缓存
.electron-cache/
.etmp/
.tmp/

# 签名证书与私钥，绝不要提交
.certs/
*.pfx
*.p12
*.key
*.pem

# 系统噪音
Thumbs.db
Desktop.ini
.DS_Store
nul
*.log
